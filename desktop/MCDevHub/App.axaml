<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MCDevHub.App"
             Name="MC Dev Hub"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Same palette as the web UI (db-sync colors) -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Bg" Color="#f6f7f9"/>
          <SolidColorBrush x:Key="Panel" Color="#ffffff"/>
          <SolidColorBrush x:Key="Panel2" Color="#f0f2f5"/>
          <SolidColorBrush x:Key="Line" Color="#dde1e7"/>
          <SolidColorBrush x:Key="Text" Color="#1c2330"/>
          <SolidColorBrush x:Key="Muted" Color="#687385"/>
          <SolidColorBrush x:Key="Accent" Color="#2f6fde"/>
          <SolidColorBrush x:Key="AccentSoft" Color="#e6eefc"/>
          <SolidColorBrush x:Key="Ok" Color="#1d8a4e"/>
          <SolidColorBrush x:Key="Warn" Color="#c98a12"/>
          <SolidColorBrush x:Key="Danger" Color="#c93b3b"/>
          <SolidColorBrush x:Key="ErrBg" Color="#fbe9e9"/>
          <SolidColorBrush x:Key="CodeBg" Color="#0f1520"/>
          <SolidColorBrush x:Key="CodeText" Color="#d7e1f0"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Bg" Color="#11151c"/>
          <SolidColorBrush x:Key="Panel" Color="#171c25"/>
          <SolidColorBrush x:Key="Panel2" Color="#1e2430"/>
          <SolidColorBrush x:Key="Line" Color="#2b3240"/>
          <SolidColorBrush x:Key="Text" Color="#e3e8f0"/>
          <SolidColorBrush x:Key="Muted" Color="#8b95a7"/>
          <SolidColorBrush x:Key="Accent" Color="#5b8ff0"/>
          <SolidColorBrush x:Key="AccentSoft" Color="#1f2d48"/>
          <SolidColorBrush x:Key="Ok" Color="#3fbf78"/>
          <SolidColorBrush x:Key="Warn" Color="#e0a83a"/>
          <SolidColorBrush x:Key="Danger" Color="#e26464"/>
          <SolidColorBrush x:Key="ErrBg" Color="#3a1c1c"/>
          <SolidColorBrush x:Key="CodeBg" Color="#0b0f16"/>
          <SolidColorBrush x:Key="CodeText" Color="#d7e1f0"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#2f6fde" RegionColor="#ffffff" ErrorText="#c93b3b"/>
        <ColorPaletteResources x:Key="Dark" Accent="#5b8ff0" RegionColor="#171c25" ErrorText="#e26464"/>
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource Bg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="13.5"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style Selector="TextBlock.h">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,6"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="{DynamicResource Panel}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.go">
      <Setter Property="Background" Value="{DynamicResource Ok}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.go:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Ok}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Opacity" Value="0.9"/>
    </Style>
    <Style Selector="TextBox, NumericUpDown, ComboBox">
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </Application.Styles>
</Application>
